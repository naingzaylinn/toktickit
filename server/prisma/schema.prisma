// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Lab 1 / Lab 2 reference data
// ---------------------------------------------------------------------------

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[]
}

model RelatedSystem {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[]
}

enum RequestedPriority {
  Low
  Medium
  High
  Urgent
}

enum TicketStatus {
  New
  Open
  InProgress
  WaitingForRequester
  Resolved
  Closed
  Reopened
  Cancelled
}

enum TicketEventType {
  ATTACHMENT_REMOVED
}

model Ticket {
  id                String            @id @default(uuid())
  ticketNumber      String            @unique
  ticketDate        DateTime          @default(now())
  currentStatus     TicketStatus      @default(New)
  requestedPriority RequestedPriority @default(Medium)
  summary           String
  description       String
  clientRequestId   String
  requesterId       String
  categoryId        Int
  relatedSystemId   String
  ownerId           String?
  workflowVersion   Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  requester     User          @relation("RequesterTickets", fields: [requesterId], references: [id])
  owner         User?         @relation("OwnedTickets", fields: [ownerId], references: [id])
  category      Category      @relation(fields: [categoryId], references: [id])
  relatedSystem RelatedSystem @relation(fields: [relatedSystemId], references: [id])

  itPriority               RequestedPriority @default(Medium)
  problemAppearsResolvedAt DateTime?
  publicComments           PublicComment[]
  internalNotes            InternalNote[]

  attachments Attachment[]
  events      TicketEvent[]
  actionsTaken ActionTaken[]

  @@unique([requesterId, clientRequestId])
  @@index([requesterId])
  @@index([categoryId])
  @@index([ownerId])
  @@index([relatedSystemId])
  @@index([ticketDate])
  @@index([currentStatus, ownerId])
  @@index([updatedAt(sort: Desc), ticketNumber(sort: Asc)])
}

model Attachment {
  id                   String    @id @default(uuid())
  ticketId             String
  originalFilename     String
  mimeType             String
  sizeBytes            Int
  storageKey           String    @unique
  isRemoved            Boolean   @default(false)
  removedAt            DateTime?
  removedByRequesterId String?
  removalReason        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  ticket             Ticket        @relation(fields: [ticketId], references: [id])
  removedByRequester User?         @relation("AttachmentRemovedBy", fields: [removedByRequesterId], references: [id])
  events             TicketEvent[]

  @@index([ticketId])
  @@index([ticketId, isRemoved])
  @@index([removedByRequesterId])
}

model TicketEvent {
  id               String          @id @default(uuid())
  ticketId         String
  attachmentId     String?
  actorRequesterId String?
  eventType        TicketEventType
  details          Json?
  createdAt        DateTime        @default(now())

  ticket         Ticket      @relation(fields: [ticketId], references: [id])
  attachment     Attachment? @relation(fields: [attachmentId], references: [id])
  actorRequester User?       @relation("TicketEventActor", fields: [actorRequesterId], references: [id])

  @@index([ticketId])
  @@index([attachmentId])
  @@index([actorRequesterId])
  @@index([eventType])
  @@index([createdAt])
}

model TicketSequence {
  year      Int      @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

model DevelopmentRequester {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

model User {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  role               Role     @default(REQUESTER)
  isActive           Boolean  @default(true)
  passwordHash       String
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sessions     Session[]
  tickets      Ticket[]  @relation("RequesterTickets")
  ownedTickets Ticket[]  @relation("OwnedTickets")

  removedAttachments Attachment[]    @relation("AttachmentRemovedBy")
  ticketEvents       TicketEvent[]   @relation("TicketEventActor")
  publicComments     PublicComment[]
  internalNotes      InternalNote[]
  performedActions   ActionTaken[]         @relation("ActionPerformer")
  assignedActions    ActionTaken[]         @relation("ActionAssignee")
  actionRevisions    ActionTakenRevision[] @relation("ActionRevisionEditor")
  assignedActionRevisions ActionTakenRevision[] @relation("ActionRevisionAssignee")
  seedIdentity       SeedUserIdentity?
}

// Local seed metadata binds an immutable fixture key to an existing User ID.
model SeedUserIdentity {
  seedKey String @id
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Restrict)
}

enum ActionStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model ActionTaken {
  id                String       @id @default(uuid())
  ticketId          String
  performedById     String
  assigneeId        String
  status            ActionStatus @default(PENDING)
  actionDescription String
  actionResult      String
  followUpRequired  Boolean      @default(false)
  followUpNote      String?
  attachmentNotes   String?
  clientRequestId   String
  version           Int          @default(1)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  ticket      Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  performedBy User   @relation("ActionPerformer", fields: [performedById], references: [id], onDelete: Restrict)
  assignee    User   @relation("ActionAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  revisions   ActionTakenRevision[]

  @@unique([ticketId, performedById, clientRequestId])
  @@index([ticketId, createdAt, id])
  @@index([performedById, createdAt, id])
  @@index([assigneeId])
  @@index([ticketId, status])
}

model ActionTakenRevision {
  id                String       @id @default(uuid())
  actionId          String
  editorId          String
  version           Int
  actionDescription String
  actionResult      String
  followUpRequired  Boolean
  followUpNote      String?
  attachmentNotes   String?
  assigneeId        String
  status            ActionStatus
  createdAt         DateTime     @default(now())

  action   ActionTaken @relation(fields: [actionId], references: [id], onDelete: Restrict)
  editor   User @relation("ActionRevisionEditor", fields: [editorId], references: [id], onDelete: Restrict)
  assignee User @relation("ActionRevisionAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)

  @@unique([actionId, version])
  @@index([editorId])
  @@index([assigneeId])
}

model Session {
  id        String   @id @default(uuid())
  // SHA-256 digest of the opaque browser token; never the bearer token itself.
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model LoginAttempt {
  key      String     @id
  failures DateTime[]
}

model PublicComment {
  id        String   @id @default(uuid())
  ticketId  String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  author    User     @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
}

model InternalNote {
  id        String   @id @default(uuid())
  ticketId  String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  author    User     @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
}
